{
  "name": "ambigram-maker-root",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "uv run --project backend uvicorn app:app --app-dir backend --port 8000 --reload",
    "dev:frontend": "pnpm --prefix frontend dev",
    "build": "pnpm --prefix frontend build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "uv run --directory backend pytest",
    "test:frontend": "pnpm --prefix frontend test",
    "slides:build": "npm --prefix slides run build",
    "slides:build:pptx": "npm --prefix slides run build:pptx",
    "slides:check": "npm --prefix slides run check"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
