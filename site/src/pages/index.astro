---
import "../styles/global.css";
import data from "../data/site-data.json";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (src: string) => `${base}${src}`;

const repository = "https://github.com/v76nl/ambigram-maker";
const siteName = "逆さにしても、同じ言葉。";
const systemName = "日本語アンビグラム制作支援システム";
const title = `${systemName}｜${siteName}`;
const description = "180度回転しても同じ単語として読める日本語のアンビグラム (点対称の文字デザイン) を、辞書探索、フォント骨格の変形、毛筆調の描き直しで作るシステムの解説です。漢字を含む作例と生成の仕組みを、回しながら確かめられます。";
const pageUrl = new URL(base, Astro.site).href;
const ogImage = { url: new URL("og.png", pageUrl).href, width: 1200, height: 630, alt: "「長寿」の回転アンビグラム" };
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: siteName, url: pageUrl, inLanguage: "ja" },
    {
      "@type": "SoftwareSourceCode",
      name: systemName,
      description,
      url: pageUrl,
      image: ogImage.url,
      codeRepository: repository,
      programmingLanguage: ["Python", "TypeScript"],
      keywords: "アンビグラム, 回転アンビグラム, 点対称, 文字デザイン, タイポグラフィ, 漢字",
      author: { "@type": "Person", name: "v76nl", url: "https://github.com/v76nl" },
    },
  ],
}).replace(/</g, "\\u003c");


const hero = data.gallery[0];
const snapDefault = data.snap.levels.findIndex((level) => level.value === 0.75);
const thresholdDefault = data.threshold.levels.findIndex((level) => level.value === data.threshold.default);

const weightLabels = [
  { key: "area", label: "黒い部分の重なり" },
  { key: "skeleton", label: "線の骨格の一致" },
  { key: "neg_space", label: "すき間の一致" },
] as const;
const percent = (value: number) => `${Math.round(value * 100)}%`;

const steps = [
  { title: "正反を重ねる", text: "文字と、対になる文字を180度回転した形を、同じ位置に重ねます。" },
  { title: "位置を合わせる", text: "2つの形がよく重なるように、互いの位置を少しずらします。" },
  { title: "線を太らせる", text: "線を太らせて、近くにある線どうしの隙間を縮めます。" },
  { title: "線を引き寄せる", text: "近くにある線を互いの骨格へ向けて動かし、周囲は曲げが最も小さくなるように薄板スプラインで変形します。" },
  { title: "中心を求める", text: "2つの形の輪郭からの距離を調和平均し、両方の線の内側にあたる場所を強く残します。" },
  { title: "骨格を取り出す", text: "残した領域を細線化して、線の中心を通る骨格を取り出します。" },
  { title: "線を描き直す", text: "骨格に沿って、重なる部分は太く、片方だけの線は細く描き直します。" },
];

const fonts = [
  { name: "Noto Sans JP (本文)", owner: "The Noto Project Authors" },
  { name: "Zen Maru Gothic", owner: "The Zen Maru Gothic Project Authors" },
  { name: "Shippori Mincho", owner: "The Shippori Mincho Project Authors" },
  { name: "M PLUS 1p", owner: "The M+ FONT PROJECT Authors" },
  { name: "Klee One", owner: "The Klee Project Authors" },
];

const command = `git clone ${repository}.git
cd ambigram-maker
pnpm install
pnpm --prefix frontend install
pnpm dev`;

const payload = JSON.stringify({
  pipeline: data.pipeline.map((item) => item.steps.map((step) => asset(step.src))),
  snap: data.snap.levels.map((level) => ({
    value: level.value,
    result: asset(level.result.src),
    overlay: asset(level.overlay.src),
  })),
  threshold: data.threshold.levels.map((level) => ({
    value: level.value,
    region: asset(level.region.src),
    result: asset(level.result.src),
  })),
  similarity: data.similarity,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href={asset("sitemap.xml")} />
    <link rel="preload" href={asset("fonts/noto-sans-jp-subset.woff2")} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <script type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>

    <nav class="nav" aria-label="ページ内">
      <div class="wrap nav-inner">
        <a href="#how">仕組み</a>
        <a href="#snap">変形</a>
        <a href="#weights">相性</a>
        <a href="#works">作例</a>
        <a href="#run">動かす</a>
        <a class="icon-link" href={repository} aria-label="GitHub リポジトリ">
          <svg class="icon icon-solid" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
          </svg>
        </a>
      </div>
    </nav>

    <main id="main">
      <header class="hero wrap">
        <button class="hero-stage" type="button" id="hero-turn" aria-label={`「${hero.word}」を180度回転する`}>
          <img class="turnable" src={asset(hero.image.src)} width={hero.image.width} height={hero.image.height} alt={`「${hero.word}」のアンビグラム`} fetchpriority="high" />
          <span class="hero-turn" aria-hidden="true">
            <svg class="icon" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 3v5h-5" /></svg>
          </span>
        </button>
        <h1><span class="phrase">逆さにしても、</span><span class="phrase">同じ言葉。</span></h1>
      </header>

      <section class="section" id="how" aria-labelledby="how-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="how-title"><span class="phrase">2つの文字を、</span><span class="phrase">1つの形にする</span></h2>
            <p>単語の前半の文字と、後半の文字を180度回転した形を融合します。後半は前半を回転して作るため、完成した図形は必ず点対称になります。</p>
          </div>

          <dl class="facts">
            <div><dt>回転</dt><dd>180<small>度</small></dd></div>
            <div><dt>辞書</dt><dd>20<small>万語以上</small></dd></div>
            <div><dt>書体</dt><dd>9<small>種類</small></dd></div>
          </dl>

          <div class="pipeline">
            <div class="stage">
              <div class="frame" id="step-panel" role="tabpanel" aria-labelledby="step-tab-0" tabindex="0">
                <img id="step-image" src={asset(data.pipeline[0].steps[0].src)} width={data.pipeline[0].steps[0].width} height={data.pipeline[0].steps[0].height} alt={`「${data.pipeline[0].word}」の工程1: ${steps[0].title}`} />
              </div>
              <div class="stage-bar">
                <fieldset class="words" aria-label="単語">
                  {data.pipeline.map((item, index) => (
                    <label>
                      <input type="radio" name="pipeline-word" value={index} data-word={item.word} checked={index === 0} />
                      {item.word}
                    </label>
                  ))}
                </fieldset>
                <ul class="legend" id="step-legend">
                  <li><i style="--swatch: var(--muted)"></i>正位置</li>
                  <li><i style="--swatch: var(--accent)"></i>180度回転</li>
                  <li><i style="--swatch: var(--ink)"></i>重なり</li>
                </ul>
              </div>
            </div>

            <div class="steps" role="tablist" aria-orientation="vertical" aria-label="生成工程">
              {steps.map((step, index) => (
                <button class="step" type="button" role="tab" id={`step-tab-${index}`} aria-controls="step-panel" aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-title={step.title}>
                  <span class="step-no">{index + 1}</span>
                  <span class="step-title">{step.title}</span>
                  <span class="step-text">{step.text}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="snap" aria-labelledby="snap-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="snap-title"><span class="phrase">線を、</span><span class="phrase">どこまで引き寄せるか</span></h2>
            <p>引き寄せる力を強めると、ずれていた線が重なり、1本の線にまとまっていきます。強さは制作画面のスライダーで調整できます。</p>
          </div>

          <div class="compare">
            <figure>
              <div class="frame"><img id="snap-overlay" src={asset(data.snap.levels[snapDefault].overlay.src)} width={data.snap.levels[snapDefault].overlay.width} height={data.snap.levels[snapDefault].overlay.height} alt="引き寄せた後の線の重なり" /></div>
              <figcaption>線の重なり</figcaption>
            </figure>
            <figure>
              <div class="frame"><img id="snap-result" src={asset(data.snap.levels[snapDefault].result.src)} width={data.snap.levels[snapDefault].result.width} height={data.snap.levels[snapDefault].result.height} alt={`「${data.snap.word}」の生成結果`} /></div>
              <figcaption>生成結果</figcaption>
            </figure>
          </div>

          <div class="slider-row">
            <input class="slider" id="snap-slider" type="range" min="0" max={data.snap.levels.length - 1} step="1" value={snapDefault} aria-label="引き寄せる強さ" />
            <output class="slider-value" id="snap-value" for="snap-slider">{data.snap.levels[snapDefault].value * 100}%</output>
          </div>
        </div>
      </section>

      <section class="section" id="threshold" aria-labelledby="threshold-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="threshold-title"><span class="phrase">線の芯を、</span><span class="phrase">どこまで残すか</span></h2>
            <p>2つの文字の距離場のうち、最大値の何割を超える部分から中心線を取り出すかを決めます。低くすると片方の文字だけにある線も残り、高くすると両方に共通する線だけが残ります。違う文字の組では {percent(data.threshold.default)} を使っています。</p>
          </div>

          <div class="compare">
            <figure>
              <div class="frame"><img id="threshold-region" src={asset(data.threshold.levels[thresholdDefault].region.src)} width={data.threshold.levels[thresholdDefault].region.width} height={data.threshold.levels[thresholdDefault].region.height} alt="中心線のもとになる領域" /></div>
              <figcaption>中心線のもとになる領域 (濃い部分)</figcaption>
            </figure>
            <figure>
              <div class="frame"><img id="threshold-result" src={asset(data.threshold.levels[thresholdDefault].result.src)} width={data.threshold.levels[thresholdDefault].result.width} height={data.threshold.levels[thresholdDefault].result.height} alt={`「${data.threshold.word}」の生成結果`} /></div>
              <figcaption>生成結果</figcaption>
            </figure>
          </div>

          <div class="slider-row">
            <input class="slider" id="threshold-slider" type="range" min="0" max={data.threshold.levels.length - 1} step="1" value={thresholdDefault} aria-label="中心線を取り出す閾値" />
            <output class="slider-value" id="threshold-value" for="threshold-slider">{percent(data.threshold.default)}</output>
          </div>
        </div>
      </section>

      <section class="section" id="weights" aria-labelledby="weights-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="weights-title"><span class="phrase">形の近さを、</span><span class="phrase">何で測るか</span></h2>
            <p>単語を探すときは、文字と、対になる文字を180度回転した形がどれだけ近いかを3つの観点で測り、重みを付けて足し合わせます。重みを動かすと、作例の単語の点数と順位がその場で変わります。</p>
          </div>

          <div class="weights">
            <div class="weight-controls">
              {weightLabels.map(({ key, label }) => (
                <div class="weight-row">
                  <label for={`weight-${key}`}>{label}</label>
                  <input class="slider" id={`weight-${key}`} data-weight={key} type="range" min="0" max="100" step="1" value={Math.round(data.similarity.weights[key] * 100)} />
                  <output class="weight-value" id={`weight-${key}-value`} for={`weight-${key}`}>{percent(data.similarity.weights[key])}</output>
                </div>
              ))}
              <button class="reset" type="button" id="weight-reset">既定の重みに戻す</button>
            </div>
            <ol class="ranking" id="ranking" aria-label="作例の単語の点数"></ol>
          </div>
        </div>
      </section>

      <section class="section" id="works" aria-labelledby="works-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="works-title">回して読む</h2>
            <p>システムで生成し、書体や線の太さ、位置を人が調整した作例です。</p>
          </div>

          <div class="gallery">
            {data.gallery.map((work) => (
              <figure class="work">
                <button type="button" data-turn aria-label={`「${work.word}」を180度回転する`}>
                  <img class="turnable" src={asset(work.image.src)} width={work.image.width} height={work.image.height} alt={`「${work.word}」のアンビグラム`} loading="lazy" />
                </button>
                <figcaption>{work.word}<span>{work.font}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="run" aria-labelledby="run-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="run-title">手元で動かす</h2>
            <p>単語の探索と生成は Python のサーバーで動くため、制作画面はローカルで起動します。起動後に、ブラウザで 127.0.0.1:5173 を開いてください。</p>
          </div>

          <div class="run">
            <ul class="run-needs" aria-label="必要な環境">
              <li>Python 3.13</li>
              <li>uv</li>
              <li>Node.js</li>
              <li>pnpm</li>
            </ul>
            <div class="code">
              <pre id="run-command" tabindex="0"><code>{command}</code></pre>
              <button class="copy" type="button" id="copy-command" aria-label="コマンドをコピー">
                <svg class="icon icon-copy" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h11v11H9zM5 15H4V4h11v1" /></svg>
                <svg class="icon icon-done" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap credits">
        <div>
          <h2>辞書</h2>
          <p><a href="https://www.edrdg.org/wiki/index.php/JMdict-EDICT_Dictionary_Project">JMdict</a> © Electronic Dictionary Research and Development Group. <a href="https://www.edrdg.org/edrdg/licence.html">CC BY-SA 4.0</a></p>
        </div>
        <div>
          <h2>書体</h2>
          <ul>
            {fonts.map((font) => <li>{font.name} © {font.owner}. <a href="https://openfontlicense.org/">SIL OFL 1.1</a></li>)}
          </ul>
        </div>
        <div>
          <h2>参考文献</h2>
          <ul>
            <li>井上 和輝, 高橋 裕樹. 文字構造特徴を用いたひらがなアンビグラムの生成. 画像電子学会誌, 49(4), 2020. <a href="https://doi.org/10.11371/iieej.49.301">DOI</a></li>
            <li>魏 延輝, 山口 裕. 多目的最適化 GAN によるアンビグラム生成. 電気・情報関係学会九州支部連合大会, 2023. <a href="https://doi.org/10.11527/jceeek.2023.0_39">DOI</a></li>
            <li>F. L. Bookstein. Principal Warps: Thin-Plate Splines and the Decomposition of Deformations. IEEE TPAMI, 11(6), 1989. <a href="https://doi.org/10.1109/34.24792">DOI</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script type="application/json" id="site-data" set:html={payload}></script>
    <script>
      const data = JSON.parse(document.getElementById("site-data")!.textContent!);
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function turn(image: HTMLElement) {
        const next = Number(image.dataset.turn ?? 0) + 180;
        image.dataset.turn = String(next);
        image.style.setProperty("--turn", `${next}deg`);
      }

      const heroButton = document.getElementById("hero-turn")!;
      const heroImage = heroButton.querySelector<HTMLElement>("img")!;
      heroButton.addEventListener("click", () => turn(heroImage));
      if (!reduceMotion) window.setTimeout(() => turn(heroImage), 1200);

      document.querySelectorAll<HTMLButtonElement>("[data-turn]").forEach((button) => {
        const image = button.querySelector<HTMLElement>("img")!;
        button.addEventListener("click", () => turn(image));
      });

      const tabs = [...document.querySelectorAll<HTMLButtonElement>(".step")];
      const words = [...document.querySelectorAll<HTMLInputElement>('input[name="pipeline-word"]')];
      const stepImage = document.getElementById("step-image") as HTMLImageElement;
      const stepPanel = document.getElementById("step-panel")!;
      const legend = document.getElementById("step-legend")!;
      let activeStep = 0;
      let activeWord = 0;

      function renderStep() {
        stepImage.src = data.pipeline[activeWord][activeStep];
        stepImage.alt = `「${words[activeWord].dataset.word}」の工程${activeStep + 1}: ${tabs[activeStep].dataset.title}`;
        stepPanel.setAttribute("aria-labelledby", tabs[activeStep].id);
        legend.hidden = activeStep > 3;
        tabs.forEach((tab, index) => {
          const selected = index === activeStep;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          activeStep = index;
          renderStep();
        });
        tab.addEventListener("keydown", (event) => {
          const moves: Record<string, number> = {
            ArrowDown: (index + 1) % tabs.length,
            ArrowUp: (index - 1 + tabs.length) % tabs.length,
            Home: 0,
            End: tabs.length - 1,
          };
          if (!(event.key in moves)) return;
          event.preventDefault();
          activeStep = moves[event.key];
          renderStep();
          tabs[activeStep].focus();
        });
      });

      words.forEach((word, index) => {
        word.addEventListener("change", () => {
          activeWord = index;
          renderStep();
        });
      });

      const slider = document.getElementById("snap-slider") as HTMLInputElement;
      const snapValue = document.getElementById("snap-value")!;
      const snapOverlay = document.getElementById("snap-overlay") as HTMLImageElement;
      const snapResult = document.getElementById("snap-result") as HTMLImageElement;

      function renderSnap() {
        const index = Number(slider.value);
        const level = data.snap[index];
        const percent = `${Math.round(level.value * 100)}%`;
        snapOverlay.src = level.overlay;
        snapResult.src = level.result;
        snapValue.textContent = percent;
        slider.setAttribute("aria-valuetext", percent);
        slider.style.setProperty("--p", `${(index / (data.snap.length - 1)) * 100}%`);
      }

      slider.addEventListener("input", renderSnap);
      renderSnap();

      // スライダーで切り替える画像は、その節に近づいてから先読みする
      function preloadNear(sectionId: string, sources: string[]) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            sources.forEach((src) => {
              new Image().src = src;
            });
          },
          { rootMargin: "600px 0px" },
        );
        observer.observe(document.getElementById(sectionId)!);
      }
      preloadNear("snap", data.snap.flatMap((level: { overlay: string; result: string }) => [level.overlay, level.result]));

      const thresholdSlider = document.getElementById("threshold-slider") as HTMLInputElement;
      const thresholdValue = document.getElementById("threshold-value")!;
      const thresholdRegion = document.getElementById("threshold-region") as HTMLImageElement;
      const thresholdResult = document.getElementById("threshold-result") as HTMLImageElement;

      function renderThreshold() {
        const index = Number(thresholdSlider.value);
        const level = data.threshold[index];
        const percent = `${Math.round(level.value * 100)}%`;
        thresholdRegion.src = level.region;
        thresholdResult.src = level.result;
        thresholdValue.textContent = percent;
        thresholdSlider.setAttribute("aria-valuetext", percent);
        thresholdSlider.style.setProperty("--p", `${(index / (data.threshold.length - 1)) * 100}%`);
      }

      thresholdSlider.addEventListener("input", renderThreshold);
      renderThreshold();
      preloadNear("threshold", data.threshold.flatMap((level: { region: string; result: string }) => [level.region, level.result]));

      type Pair = { valid: boolean; area: number; skeleton: number; neg_space: number };
      type Weights = { area: number; skeleton: number; neg_space: number };
      const weightKeys = ["area", "skeleton", "neg_space"] as const;
      const weightSliders = weightKeys.map((key) => document.getElementById(`weight-${key}`) as HTMLInputElement);
      const ranking = document.getElementById("ranking")!;

      // backend/generators/font_manager.py の compute_word_cognitive_score と同じ式 (日常語の補正なし)
      function wordScore(scores: number[], length: number) {
        const geom = Math.pow(scores.reduce((p, s) => p * Math.max(0.01, s), 1), 1 / scores.length);
        const min = Math.min(...scores);
        const context = length > 1 ? (length - 1) / length : 0;
        const reduction = Math.min(1, geom * geom * context);
        const wMin = 0.25 * (1 - 0.8 * reduction);
        return (1 - wMin) * geom + wMin * min;
      }

      function currentWeights(): Weights {
        const [area, skeleton, negSpace] = weightSliders.map((slider) => Number(slider.value) / 100);
        return { area, skeleton, neg_space: negSpace };
      }

      // 3つの重みの合計を常に 100% に保つ。動かした重みの残りを、ほかの2つに今の比率で配り直す
      function balanceWeights(moved: number) {
        const value = Number(weightSliders[moved].value);
        const others = weightSliders.filter((_, i) => i !== moved);
        const rest = 100 - value;
        const current = others.map((slider) => Number(slider.value));
        const total = current.reduce((a, b) => a + b, 0);
        const first = Math.round(total > 0 ? (rest * current[0]) / total : rest / 2);
        others[0].value = String(first);
        others[1].value = String(rest - first);
      }

      function renderWeights() {
        const weights = currentWeights();
        weightKeys.forEach((key, i) => {
          const text = `${Math.round(weights[key] * 100)}%`;
          document.getElementById(`weight-${key}-value`)!.textContent = text;
          weightSliders[i].setAttribute("aria-valuetext", text);
          weightSliders[i].style.setProperty("--p", `${weightSliders[i].value}%`);
        });
        const rows = data.similarity.words.map((item: { word: string; pairs: Pair[] }) => {
          const scores = item.pairs.map((pair) =>
            pair.valid ? Math.min(1, Math.max(0, weightKeys.reduce((sum, key) => sum + weights[key] * pair[key], 0))) : 0,
          );
          return { word: item.word, score: wordScore(scores, item.word.length) };
        });
        rows.sort((a: { score: number }, b: { score: number }) => b.score - a.score);
        ranking.replaceChildren(
          ...rows.map((row: { word: string; score: number }) => {
            const li = document.createElement("li");
            const word = document.createElement("span");
            word.className = "ranking-word";
            word.textContent = row.word;
            const bar = document.createElement("span");
            bar.className = "ranking-bar";
            bar.style.setProperty("--w", `${row.score * 100}%`);
            const value = document.createElement("span");
            value.className = "ranking-value";
            value.textContent = `${(row.score * 100).toFixed(1)}`;
            li.append(word, bar, value);
            return li;
          }),
        );
      }

      weightSliders.forEach((slider, i) =>
        slider.addEventListener("input", () => {
          balanceWeights(i);
          renderWeights();
        }),
      );
      document.getElementById("weight-reset")!.addEventListener("click", () => {
        weightKeys.forEach((key, i) => {
          weightSliders[i].value = String(Math.round(data.similarity.weights[key] * 100));
        });
        renderWeights();
      });
      renderWeights();

      const copyButton = document.getElementById("copy-command")!;
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(document.getElementById("run-command")!.textContent!);
          copyButton.dataset.done = "";
          copyButton.setAttribute("aria-label", "コピーしました");
          window.setTimeout(() => {
            delete copyButton.dataset.done;
            copyButton.setAttribute("aria-label", "コマンドをコピー");
          }, 1600);
        } catch {
          copyButton.setAttribute("aria-label", "コピーできませんでした");
        }
      });
    </script>
  </body>
</html>
